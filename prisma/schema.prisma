generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  passwordHash        String
  profile             Profile?
  workouts            Workout[]
  workoutHistories    WorkoutHistory[]
  exerciseHistories   ExerciseHistory[]
  runningHistories    RunningHistory[]
  goals               Goal[]
  records             Record[]
  dailySteps          DailySteps[]
  readyPlanFavorites  ReadyPlanFavorite[]
  authRefreshSessions AuthRefreshSession[]
  workoutSyncEvents   WorkoutSyncEvent[]
  workoutSyncSessions WorkoutSyncSession[]
  workoutSyncSets     WorkoutSyncSet[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("users")
}

model AuthRefreshSession {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_refresh_sessions")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight    Float
  height    Float
  age       Int
  goal      String
  level     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model Workout {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  description      String
  goal             String
  level            String
  split            String
  daysPerWeek      Int
  estimatedMinutes Int
  source           String           @default("manual")
  readyPlanId      String?
  readyPlan        ReadyPlan?       @relation("ReadyPlanCopies", fields: [readyPlanId], references: [id], onDelete: SetNull)
  days             WorkoutDay[]
  histories        WorkoutHistory[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, readyPlanId])
  @@index([userId])
  @@index([readyPlanId])
  @@map("workouts")
}

model WorkoutDay {
  id          String               @id @default(uuid())
  workoutId   String
  workout     Workout              @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name        String
  weekday     String
  muscleGroup String
  order       Int
  exercises   WorkoutDayExercise[]

  @@index([workoutId])
  @@map("workout_days")
}

model Exercise {
  id                  String               @id @default(uuid())
  name                String
  muscleGroup         String
  equipment           String
  difficulty          String
  gifKey              String
  workoutDayExercises WorkoutDayExercise[]
  exerciseHistories   ExerciseHistory[]
  records             Record[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([muscleGroup])
  @@map("exercises")
}

model WorkoutDayExercise {
  id           String     @id @default(uuid())
  workoutDayId String
  workoutDay   WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  order        Int
  sets         Int
  reps         Int
  repsText     String?
  restSeconds  Int
  rir          String?
  cadence      String?
  notes        String?

  @@index([workoutDayId])
  @@index([exerciseId])
  @@map("workout_day_exercises")
}

model WorkoutHistory {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutId         String
  workout           Workout           @relation(fields: [workoutId], references: [id], onDelete: Restrict)
  startedAt         DateTime
  finishedAt        DateTime
  totalVolume       Float
  totalSets         Int
  durationSeconds   Int
  exerciseHistories ExerciseHistory[]

  @@index([userId])
  @@index([workoutId])
  @@map("workout_histories")
}

model ExerciseHistory {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId       String
  exercise         Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  exerciseKey      String         @default("")
  exerciseName     String         @default("")
  workoutHistoryId String
  workoutHistory   WorkoutHistory @relation(fields: [workoutHistoryId], references: [id], onDelete: Cascade)
  workoutSessionId String         @default("")
  setNumber        Int            @default(1)
  completed        Boolean        @default(true)
  weight           Float
  reps             Int
  sets             Int
  restSeconds      Int?
  rir              String?
  notes            String?
  volume           Float
  performedAt      DateTime

  @@index([userId])
  @@index([exerciseId])
  @@index([userId, exerciseKey])
  @@index([userId, workoutSessionId])
  @@index([workoutHistoryId])
  @@map("exercise_histories")
}

model RunningHistory {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  distanceKm      Float
  durationSeconds Int
  averageSpeed    Float
  performedAt     DateTime

  @@index([userId])
  @@map("running_histories")
}

model DailySteps {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  steps     Int
  goal      Int
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_steps")
}

model Goal {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  category     String
  currentValue Float
  targetValue  Float
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("goals")
}

model Record {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String?
  exercise   Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  title      String
  category   String
  value      Float
  unit       String
  achievedAt DateTime

  @@index([userId])
  @@index([exerciseId])
  @@map("records")
}

model ReadyPlan {
  id               String              @id @default(uuid())
  slug             String              @unique
  name             String
  description      String
  coverImage       String
  category         String
  level            String
  goal             String
  split            String
  daysPerWeek      Int
  estimatedMinutes Int
  isActive         Boolean             @default(true)
  featured         Boolean             @default(false)
  popularityCount  Int                 @default(0)
  days             ReadyPlanDay[]
  copiedWorkouts   Workout[]           @relation("ReadyPlanCopies")
  favorites        ReadyPlanFavorite[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([category])
  @@index([isActive])
  @@map("ready_plans")
}

model ReadyPlanDay {
  id          String              @id @default(uuid())
  readyPlanId String
  readyPlan   ReadyPlan           @relation(fields: [readyPlanId], references: [id], onDelete: Cascade)
  name        String
  title       String
  weekday     String?
  muscleGroup String
  order       Int
  exercises   ReadyPlanExercise[]

  @@unique([readyPlanId, order])
  @@index([readyPlanId])
  @@map("ready_plan_days")
}

model ReadyPlanExercise {
  id             String       @id @default(uuid())
  readyPlanDayId String
  readyPlanDay   ReadyPlanDay @relation(fields: [readyPlanDayId], references: [id], onDelete: Cascade)
  name           String
  category       String
  muscles        String[]
  equipment      String[]
  sets           Int
  reps           String
  restSeconds    Int
  rir            String?
  cadence        String?
  notes          String?
  order          Int

  @@unique([readyPlanDayId, order])
  @@index([readyPlanDayId])
  @@map("ready_plan_exercises")
}

model ReadyPlanFavorite {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  readyPlanId String
  readyPlan   ReadyPlan @relation(fields: [readyPlanId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, readyPlanId])
  @@index([userId])
  @@index([readyPlanId])
  @@map("ready_plan_favorites")
}

model WorkoutSyncEvent {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId       String
  eventId        String
  idempotencyKey String
  aggregateId    String
  eventType      String
  payload        Json
  payloadHash    String
  occurredAt     DateTime
  processedAt    DateTime @default(now())
  status         String
  error          String?
  version        Int

  @@unique([userId, idempotencyKey])
  @@unique([userId, eventId])
  @@index([userId, aggregateId])
  @@index([userId, processedAt])
  @@map("workout_sync_events")
}

model WorkoutSyncSession {
  id                   String           @id @default(uuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalSessionId    String
  planId               String
  workoutId            String
  status               String
  startedAt            DateTime
  finishedAt           DateTime?
  currentExerciseIndex Int              @default(0)
  currentSetIndex      Int              @default(0)
  restEndsAt           DateTime?
  version              Int              @default(1)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  sets                 WorkoutSyncSet[]

  @@unique([userId, externalSessionId])
  @@index([userId, status])
  @@map("workout_sync_sessions")
}

model WorkoutSyncSet {
  id            String             @id @default(uuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String
  session       WorkoutSyncSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  externalSetId String
  exerciseId    String
  setIndex      Int
  weight        Float
  reps          Int
  completedAt   DateTime
  version       Int                @default(1)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([userId, externalSetId])
  @@unique([sessionId, exerciseId, setIndex])
  @@index([userId, sessionId])
  @@map("workout_sync_sets")
}
