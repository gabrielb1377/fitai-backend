PORT=3001
NODE_ENV=development

DATABASE_URL="postgresql://fitai_user:fitai_password@localhost:5432/fitai_db?schema=public"

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Usar apenas no backend. Nao colocar chave OpenAI no Flutter.
# Sem OPENAI_API_KEY, o backend usa modo mock para /ai/generate-workout.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2
