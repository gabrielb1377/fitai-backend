PORT=3001
NODE_ENV=development

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fitai_db?schema=public"

# Gere com um gerenciador de segredos: pelo menos 32 caracteres aleatorios.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d

# Usar apenas no backend. Nao colocar chave OpenAI no Flutter.
# Sem OPENAI_API_KEY, o backend usa modo mock para /ai/generate-workout.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2
# Gateway generate_workout. Blank provider preserves legacy OpenAI/mock behavior.
# Explicit provider without credentials fails closed, without automatic mock fallback.
AI_PROVIDER=
AI_PRIMARY_MODEL=
AI_FALLBACK_MODELS=
AI_REQUEST_TIMEOUT_MS=30000
# Total generation budget below the current Flutter 20s HTTP timeout.
AI_TOTAL_TIMEOUT_MS=18000
AI_MAX_ATTEMPTS=3
AI_SEMANTIC_FALLBACKS=1
OPENROUTER_API_KEY=
# OpenRouter requires AI_PRIMARY_MODEL with structured-output support.
# Gateway SDK retries = 0; OPENAI_MAX_RETRIES remains coach-only.
# Limites server-authoritative para as operacoes privadas de IA.
AI_WORKOUT_DAILY_QUOTA=10
AI_COACH_DAILY_QUOTA=30
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=12
