{
  "name": "fitai-backend",
  "version": "1.0.0",
  "description": "Backend separado para a API de IA do FitIA.",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node scripts/check-syntax.js",
    "build": "npm run check && prisma generate",
    "pretest": "prisma generate",
    "test": "node --test \"tests/**/*.test.js\"",
    "secrets:check": "node scripts/check-staged-secrets.js",
    "secrets:check:staged": "node scripts/check-staged-secrets.js --staged",
    "test:workout-sync:integration": "node scripts/run-workout-sync-postgres-integration.js",
    "test:g4:workout-sync:postgres": "node scripts/run-fitai-g4-postgres.js",
    "test:progression-sync:integration": "node scripts/run-progression-sync-postgres-integration.js",
    "test:activity-sync:integration": "node scripts/run-activity-sync-postgres-integration.js",
    "test:r1-4:auth-sync-e2e": "node scripts/run-r1-4-auth-sync-e2e.js",
    "test:r1-5:auth-lifecycle-e2e": "node scripts/run-r1-5-auth-lifecycle-e2e.js",
    "test:r1-6:ai-boundary-e2e": "node scripts/run-r1-6-ai-boundary-e2e.js",
    "test:fitai-22:e2e": "node scripts/run-fitai-22-e2e.js",
    "ai:config:check": "node scripts/check-ai-config.js",
    "test:ai:gateway": "node --test tests/ai/ai.gateway.test.js tests/ai/ai.gateway.http.test.js",
    "test:ai:chat": "node --test tests/ai/ai.chat.test.js tests/ai/ai.context.test.js",
    "test:ai:chat:integration": "node scripts/run-ai-chat-postgres-integration.js",
  "test:coach-weekly:integration": "node scripts/run-coach-weekly-postgres-integration.js",
    "test:ai:actions": "node --test tests/ai/ai.actions.test.js",
    "test:ai:actions:integration": "node scripts/run-ai-chat-postgres-integration.js actions",
    "test:ai:evals": "node --test tests/ai/ai.semantic-evals.test.js && node scripts/run-ai-evals.js",
    "ai:eval:provider": "node scripts/run-ai-evals.js --provider",
    "db:test": "node src/config/database.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "ready-plans:seed": "node src/modules/ready_plans/ready_plans.seed.js"
  },
  "keywords": [
    "fitai",
    "express",
    "ai",
    "workout"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.45.0",
    "pg": "^8.22.0",
    "zod": "^4.6.6"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "body-parser": "2.4.0",
    "qs": "6.17.0",
    "ip-address": "10.7.4"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "prisma": "^7.9.1"
  }
}
